# Copia este archivo como .env y ajusta los valores para tu entorno local.
# No incluyas credenciales reales en el repositorio.

# Clave usada por Flask para firmar la sesión (cámbiala fuera de la demo).
SECRET_KEY=cambia-esta-clave-en-desarrollo

# SQLite se crea automáticamente dentro de la carpeta instance/.
DATABASE_URL=sqlite:///clientes.db

# Ejemplo para otra base de datos (opcional):
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/clientes
